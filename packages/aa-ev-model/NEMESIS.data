[nemesis]
version=1.0
id=aa.ev.model
name=AA EV energy model (Ioniq 5 prototype)
types=application,service
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
path=bin/status.sh
uid=root

[service.0]
name=evlog-offload
kind=sh
path=svc/evlog-offload.sh
uid=root
mode=restart
